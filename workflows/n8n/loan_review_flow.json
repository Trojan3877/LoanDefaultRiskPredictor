{
  "name": "Loan Risk Review Flow",
  "nodes": [
    {
      "name": "High Risk Check",
      "type": "if",
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "{{ $json.risk_score }}",
              "operation": "larger",
              "value2": 0.75
            }
          ]
        }
      }
    },
    {
      "name": "Manual Review Queue",
      "type": "webhook",
      "parameters": {
        "path": "manual-review",
        "httpMethod": "POST"
      }
    }
  ],
  "connections": {
    "High Risk Check": {
      "true": ["Manual Review Queue"]
    }
  }
}